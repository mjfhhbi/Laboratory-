# Copy to android/keystore.properties (git-ignored) before running Release builds on Windows/Linux:
#   .\android\gradlew.bat -p android assembleRelease bundleRelease
# Note: storeFile may be relative to android/ (e.g. ../android-signing.keystore) or an absolute path.
# NEVER put real passwords or keystores in Git.
storeFile=../android-signing.keystore
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=foodscienceai
keyPassword=CHANGE_ME_KEY_PASSWORD
